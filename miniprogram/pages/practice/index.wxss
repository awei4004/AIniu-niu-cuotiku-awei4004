.practice-question { padding: 24rpx 0 32rpx; border-bottom: 1rpx solid #dfe4eb; }
.meta { color: #727b8b; font-size: 24rpx; }
.question-content, .result-content { display: block; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.8; }
.question-content { margin-top: 24rpx; font-size: 34rpx; }
.answer-area { box-sizing: border-box; width: 100%; height: 240rpx; padding: 24rpx; background: #fff; border: 1rpx solid #dfe4eb; border-radius: 12rpx; }
.submit-button { margin-top: 32rpx; }
.result-status { margin-top: 28rpx; padding: 20rpx; border-radius: 12rpx; font-weight: 600; }
.correct { background: #eaf8f0; color: #2d8a55; }
.wrong { background: #fff1f0; color: #d43828; }
.ungraded { background: #fff4db; color: #9a6411; }
.result-section { padding-bottom: 20rpx; border-bottom: 1rpx solid #e8ebf0; }
.reference { color: #2d8a55; }
.grade-actions { display: flex; gap: 12rpx; }
.grade-button { flex: 1; min-width: 0; padding: 0 8rpx; font-size: 25rpx; line-height: 76rpx; background: #fff; color: #4a5568; border: 1rpx solid #dfe4eb; }
.grade-button.selected { border-color: currentColor; }
.grade-button.correct { background: #eaf8f0; color: #2d8a55; }
.grade-button.wrong { background: #fff1f0; color: #d43828; }
.grade-button.ungraded { background: #fff4db; color: #9a6411; }
.loading-text { text-align: center; padding: 48rpx 0; color: #727b8b; }
