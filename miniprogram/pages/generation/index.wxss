.source-section { padding-bottom: 24rpx; border-bottom: 1rpx solid #dfe4eb; }
.section-label { display: block; margin-top: 20rpx; font-size: 24rpx; color: #727b8b; }
.content { display: block; margin-top: 12rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.config-row, .row-actions, .candidate-meta, .section-heading, .editor-actions { display: flex; gap: 16rpx; align-items: center; }
.config-item { flex: 1; min-width: 0; }
.generate-button { margin-top: 24rpx; }
.section-heading { margin: 30rpx 0 16rpx; justify-content: space-between; font-weight: 600; }
.candidate { padding: 24rpx; margin-bottom: 20rpx; }
.candidate-meta { justify-content: space-between; font-size: 24rpx; color: #727b8b; }
.status { padding: 6rpx 12rpx; border-radius: 8rpx; background: #fff4db; color: #9a6411; }
.status.confirmed { background: #eaf8f0; color: #2d8a55; }
.question-text { font-size: 30rpx; }
.answer { color: #2d8a55; }
.row-actions { justify-content: flex-end; margin-top: 20rpx; border-top: 1rpx solid #eef0f3; padding-top: 16rpx; flex-wrap: wrap; }
.text-button { padding: 0 12rpx; background: transparent; color: #1f6feb; font-size: 25rpx; line-height: 64rpx; }
.text-button.danger { color: #d43828; }
.compact { padding: 0 24rpx; font-size: 25rpx; line-height: 64rpx; }
.editor-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.38); z-index: 10; display: flex; align-items: flex-end; }
.editor-panel { height: 88vh; background: white; border-radius: 16rpx 16rpx 0 0; }
.editor-inner { padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); }
.editor-title { font-size: 32rpx; font-weight: 600; }
.edit-area { box-sizing: border-box; width: 100%; height: 180rpx; padding: 18rpx; border: 1rpx solid #dfe4eb; border-radius: 12rpx; background: #fff; }
.edit-area.short { height: 120rpx; }
.editor-actions { margin-top: 28rpx; }
.editor-actions button { flex: 1; }
.loading-text { padding: 48rpx 0; text-align: center; color: #727b8b; }
