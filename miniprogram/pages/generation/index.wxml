<view class="page">
  <view class="topbar"><text class="page-title">同类题</text><text class="tag">演示出题</text></view>
  <view class="loading-text" wx:if="{{loading}}">正在加载…</view>
  <view wx:if="{{!loading}}">
    <view class="source-section" wx:if="{{source}}">
      <text class="section-label">原错题</text>
      <text class="content">{{source.questionText}}</text>
    </view>
    <view class="config-row" wx:if="{{source}}">
      <view class="config-item"><text class="form-label">数量</text>
        <picker range="{{['1 道', '2 道', '3 道']}}" value="{{count - 1}}" bindchange="changeCount"><view class="picker-input">{{count}} 道</view></picker>
      </view>
      <view class="config-item"><text class="form-label">难度</text>
        <picker range="{{difficultyLabels}}" value="{{difficultyIndex}}" bindchange="changeDifficulty"><view class="picker-input">{{difficultyLabels[difficultyIndex]}}</view></picker>
      </view>
    </view>
    <button wx:if="{{source}}" class="primary-button generate-button" bindtap="generate" loading="{{busy}}" disabled="{{busy || editor}}">{{questions.length ? '再生成一组' : '生成同类题'}}</button>
    <view class="section-heading"><text>候选题 · {{questions.length}}</text><button class="text-button" bindtap="openReview">进入复习</button></view>
    <view class="empty-state" wx:if="{{!questions.length}}"><text class="empty-title">暂无候选题</text></view>
    <view class="surface candidate" wx:for="{{questions}}" wx:key="_id">
      <view class="candidate-meta"><text>{{index + 1}} · {{item.questionType}}</text><text class="status {{item.status}}">{{item.status === 'confirmed' ? '已确认' : '待确认'}}</text></view>
      <text class="content question-text">{{item.questionText}}</text>
      <text class="section-label">参考答案</text><text class="content answer">{{item.correctAnswer}}</text>
      <text class="section-label">解析</text><text class="content">{{item.analysis}}</text>
      <view class="row-actions">
        <button class="text-button" data-id="{{item._id}}" bindtap="edit" disabled="{{busy || editor}}">编辑</button>
        <button class="text-button danger" data-id="{{item._id}}" bindtap="remove" disabled="{{busy || editor}}">删除</button>
        <button wx:if="{{item.status === 'draft'}}" class="secondary-button compact" data-id="{{item._id}}" bindtap="confirm" disabled="{{busy || editor || !source}}">确认</button>
        <button wx:else class="secondary-button compact" data-id="{{item._id}}" bindtap="practice" disabled="{{busy || editor}}">练习</button>
      </view>
    </view>
  </view>
  <text class="error-text" wx:if="{{error}}">{{error}}</text>
  <button wx:if="{{error && !source}}" bindtap="loadData" class="secondary-button">重试</button>
  <view class="editor-overlay" wx:if="{{editor}}">
    <scroll-view class="editor-panel" scroll-y>
      <view class="editor-inner">
        <text class="editor-title">编辑生成题</text>
        <text class="form-label">题目</text><textarea class="edit-area" value="{{editor.questionText}}" data-field="questionText" bindinput="changeField" maxlength="5000" />
        <text class="form-label">参考答案</text><textarea class="edit-area short" value="{{editor.correctAnswer}}" data-field="correctAnswer" bindinput="changeField" maxlength="3000" />
        <text class="form-label">解析</text><textarea class="edit-area" value="{{editor.analysis}}" data-field="analysis" bindinput="changeField" maxlength="5000" />
        <text class="form-label">知识点</text><input class="text-input" value="{{editor.knowledgePoints}}" data-field="knowledgePoints" bindinput="changeField" maxlength="500" />
        <text class="form-label">判题方式</text><picker range="{{answerTypeLabels}}" value="{{answerTypeIndex}}" bindchange="changeAnswerType"><view class="picker-input">{{answerTypeLabels[answerTypeIndex]}}</view></picker>
        <view class="editor-actions"><button class="muted-button" bindtap="closeEditor" disabled="{{busy}}">取消</button><button class="primary-button" bindtap="saveEditor" disabled="{{busy}}" loading="{{busy}}">保存</button></view>
      </view>
    </scroll-view>
  </view>
</view>
