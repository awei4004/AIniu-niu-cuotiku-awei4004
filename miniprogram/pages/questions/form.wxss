.form-page {
  padding-bottom: 64rpx;
}

.form-card {
  padding: 28rpx;
}

.form-section-title {
  display: block;
  color: #263044;
  font-size: 30rpx;
  font-weight: 600;
}

.optional-section {
  margin-top: 42rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #eef0f3;
}

.required-label::after {
  content: ' *';
  color: #d43828;
}

.form-columns {
  display: flex;
  gap: 16rpx;
}

.form-column {
  min-width: 0;
  flex: 1;
}

.textarea-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #dfe4eb;
  border-radius: 12rpx;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.6;
}

.question-textarea {
  min-height: 230rpx;
}

.save-button {
  margin-top: 32rpx;
}

.image-section {
  margin-top: 32rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #eef0f3;
  border-bottom: 1rpx solid #eef0f3;
}

.image-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.image-meta, .upload-state, .ocr-status {
  color: #727b8b;
  font-size: 24rpx;
  line-height: 1.6;
}

.image-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.image-command {
  flex: 1;
  min-width: 190rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.source-image {
  display: block;
  width: 100%;
  height: 300rpx;
  margin-top: 20rpx;
  background: #f7f8fa;
}

.upload-state, .ocr-status {
  display: block;
  margin-top: 16rpx;
  word-break: break-all;
}

.apply-button {
  margin-top: 16rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
}
