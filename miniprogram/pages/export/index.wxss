.export-page { padding-bottom: 64rpx; }
.export-format, .selection-count, .task-meta { color: #687385; font-size: 24rpx; }
.export-section { padding: 24rpx 0 32rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #dfe4eb; }
.export-heading { display: block; font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.section-row, .setting-row, .selection-filters, .template-options, .selection-commands { display: flex; align-items: center; gap: 20rpx; }
.section-row, .setting-row { justify-content: space-between; }
.section-row .export-heading { flex: 1; min-width: 0; }
.selection-count, .task-status { flex-shrink: 0; }
.template-options { margin: 16rpx 0; flex-wrap: wrap; }
.template-options label { display: flex; align-items: center; margin-right: 32rpx; min-height: 76rpx; }
.setting-row { margin-top: 20rpx; min-height: 72rpx; }
.inline-picker { min-height: 72rpx; line-height: 72rpx; color: #1f6feb; font-size: 26rpx; }
.selection-filters { margin: 20rpx 0; }
.selection-search { flex: 1; min-width: 0; height: 76rpx; padding: 0 16rpx; border: 1rpx solid #dfe4eb; border-radius: 8rpx; background: #fff; }
.selection-commands { margin-bottom: 12rpx; flex-wrap: wrap; }
.compact-command { padding: 0 20rpx; min-height: 64rpx; line-height: 64rpx; font-size: 24rpx; }
.export-question { display: flex; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid #e8ebf0; }
.export-question checkbox { flex-shrink: 0; margin-right: 14rpx; }
.question-copy, .history-copy { flex: 1; min-width: 0; }
.question-subject { display: block; font-size: 23rpx; color: #687385; margin-bottom: 8rpx; }
.export-question-text { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6; overflow-wrap: anywhere; white-space: pre-wrap; }
.export-empty { display: block; text-align: center; color: #687385; padding: 36rpx 0; }
.task-meta { display: block; margin: 14rpx 0 24rpx; }
.task-status { font-size: 24rpx; color: #18784e; }
.history-row { display: flex; gap: 20rpx; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #e8ebf0; }
.history-title { display: block; overflow-wrap: anywhere; line-height: 1.5; }
.history-meta { display: block; margin-top: 8rpx; color: #687385; font-size: 22rpx; line-height: 1.6; }
.history-status { flex-shrink: 0; font-size: 23rpx; color: #687385; }
.pdf-canvas { position: fixed; left: -4000px; top: 0; width: 596px; height: 842px; pointer-events: none; }
