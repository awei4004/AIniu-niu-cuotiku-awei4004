page {
  background: #f7f8fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.page-title {
  color: #172033;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7c8494;
  font-size: 25rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #e8ebf0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 39, 63, 0.04);
}

.primary-button {
  background: #1f6feb;
  color: #ffffff;
}

.secondary-button {
  background: #eef5ff;
  color: #1f6feb;
}

.muted-button {
  background: #f1f3f5;
  color: #727b8b;
}

.danger-button {
  background: #fff1f0;
  color: #d43828;
}

.empty-state {
  padding: 96rpx 40rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #263044;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-text {
  display: block;
  margin: 16rpx 0 32rpx;
  color: #8a92a1;
  font-size: 25rpx;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef5ff;
  color: #1f6feb;
  font-size: 23rpx;
}

.form-label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #4a5568;
  font-size: 26rpx;
  font-weight: 600;
}

.text-input,
.picker-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe4eb;
  border-radius: 12rpx;
  background: #ffffff;
  color: #172033;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.placeholder {
  color: #a4abb6;
}

.error-text {
  display: block;
  margin-top: 10rpx;
  color: #d43828;
  font-size: 24rpx;
}
